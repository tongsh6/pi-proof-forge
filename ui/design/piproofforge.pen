            {
              "type": "text",
              "id": "nXtO4",
              "name": "uxSubtitle",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Implemented in ui/src/styles/globals.css (.page-header, .page-icon-button, .stat-strip, .fold-section, .seg-tabs), components/shell/AppShell.tsx and all nine pages/*/index.tsx. Pen components: Layout/PageHeader, Layout/StatStrip, Layout/SegTabs, Layout/FoldSection, Overview/SetupChecklist.",
